# Impresa Viva — Supabase environment variables (DEV/TEST project)
#
# Copy this file to .env.local and fill in real values from the Supabase
# project dashboard (Project Settings -> API / Database).
# Never commit .env.local or any file containing real values.

# --- Public (safe to expose to the browser, prefixed NEXT_PUBLIC_) ---

# Project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon public key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Secret (server-only, never sent to the browser, not needed yet) ---
# Leave empty for now. Only required once server-side admin operations are
# implemented. Do not request or paste these until that step.

# Service role key (Project Settings -> API -> Project API keys -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Database password (Project Settings -> Database -> Connection string)
SUPABASE_DB_PASSWORD=

# --- Tooling config (not secret, used by the Supabase CLI) ---

# Project ref / id (Project Settings -> General -> Reference ID)
SUPABASE_PROJECT_REF=
